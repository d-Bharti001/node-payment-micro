{
    "name": "email",
    "version": "1.0.0",
    "description": "email service for payment microservices",
    "main": "src/index.ts",
    "scripts": {
        "build": "rm -rf build/ && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
        "dev": "tsx watch --env-file=.env src/index.ts",
        "start": "node --env-file=.env build/src/index.js",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^26.6.2",
        "testcontainers": "^12.1.0",
        "tsc-alias": "^1.9.5",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "kafkajs": "^2.2.4",
        "nodemailer": "^10.0.10"
    }
}
