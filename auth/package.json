{
    "name": "auth",
    "version": "1.0.0",
    "description": "authentication service for payment microservices",
    "main": "src/index.ts",
    "scripts": {
        "build": "rm -rf build/ && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && mkdir -p build/proto && cp proto/auth.proto build/proto/auth.proto",
        "dev": "tsx watch --env-file=.env src/index.ts",
        "proto:gen": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --outDir=proto/ proto/*.proto",
        "start": "node --env-file=.env build/src/index.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.2.0",
        "tsc-alias": "^1.9.2",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "bcrypt": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.24.2"
    }
}
