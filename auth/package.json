{
    "name": "auth",
    "version": "1.0.0",
    "description": "authentication service for payment microservices",
    "main": "src/server.ts",
    "scripts": {
        "build": "rm -rf build/ && tsc -p tsconfig.build.json",
        "dev": "tsx watch --env-file=.env src/server.ts",
        "proto:gen": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --outDir=proto/ proto/*.proto",
        "start": "node --env-file=.env build/server.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^26.2.0",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "mysql2": "^3.24.2"
    }
}
