{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        "outDir": "./build",
        "paths": {
            "src/*": ["./src/*"],
            "proto/*": ["./proto/*"]
        },

        "target": "es2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*", "proto/**/*.ts"],
    "exclude": ["node_modules"]
}
