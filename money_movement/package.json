{
    "name": "money_movement",
    "version": "1.0.0",
    "description": "money movement service for payment microservices",
    "main": "src/index.ts",
    "scripts": {
        "build": "rm -rf build/ && tsc -p tsconfig.json && tsc-alias -p tsconfig.json && mkdir -p build/proto && cp proto/money_movement.proto build/proto/money_movement.proto",
        "dev": "tsx watch --env-file=.env src/index.ts",
        "migrate:create": "node --env-file=.env node_modules/.bin/db-migrate create",
        "migrate:up": "node --env-file=.env node_modules/.bin/db-migrate up",
        "migrate:down": "node --env-file=.env node_modules/.bin/db-migrate down",
        "proto:gen": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --longs=String --enums=String --defaults --oneofs --outDir=proto/ proto/*.proto",
        "seed": "tsx --env-file=.env scripts/seed.ts",
        "start": "node --env-file=.env build/src/index.js",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "relay:dev": "tsx watch --env-file=.env src/outboxRelay.ts",
        "relay:start": "node --env-file=.env build/src/outboxRelay.js"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@grpc/grpc-js": "^1.14.4",
        "@grpc/proto-loader": "^0.8.1",
        "db-migrate": "^0.11.14",
        "db-migrate-mysql": "^3.0.0",
        "kafkajs": "^2.2.4",
        "mysql2": "^3.24.2"
    },
    "devDependencies": {
        "@testcontainers/mysql": "^12.1.0",
        "@types/node": "^26.3.0",
        "tsc-alias": "^1.9.2",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    }
}
